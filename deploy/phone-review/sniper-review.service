# GATED TEMPLATE: private broker required; page must never receive shared DB access.
[Unit]
Description=Private known-listing review
After=caddy.service sniper-review-broker.service
Requires=caddy.service sniper-review-broker.service

[Service]
Type=simple
User=sniper-review
Group=sniper-review-proxy
SupplementaryGroups=sniper-review-broker
RuntimeDirectory=sniper-review
RuntimeDirectoryMode=0750
UMask=0007
WorkingDirectory=/opt/sniper-review
ExecStart=/opt/sniper-review/venv/bin/python -I -m finder.discogs_phone_review_server --broker-socket /run/sniper-review-broker/broker.sock --broker-user sniper --origin https://vps-a0c5b746.vps.ovh.us:8443 --principal review-owner --socket-directory /run/sniper-review
Restart=no
TimeoutStopSec=35
KillSignal=SIGTERM
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/sniper-review
# Confirm all secret paths on host; dedicated UID must have no secret-reading groups.
InaccessiblePaths=/var/lib/sniper /etc/sniper /root /home /etc/caddy /run/caddy-admin
MemoryMax=192M
TasksMax=16
LimitNOFILE=128
LimitCORE=0
# This host lacks systemd BPF support. No IPAddressDeny enforcement is claimed.
# Complete the separately reviewed private Caddy admin socket transition first.
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
