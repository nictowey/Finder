# eBay Developer application credentials, NOT your eBay login.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production

# Relative SQLite paths resolve from the current working directory.
FINDER_DATABASE_URL=sqlite:///finder.db
FINDER_LOG_LEVEL=INFO
# Optional shipping destination; provide BOTH for accurate calculated shipping.
EBAY_DELIVERY_COUNTRY=US
EBAY_DELIVERY_POSTAL_CODE=

# Discogs personal access token from Settings > Developers.
DISCOGS_TOKEN=
# Discogs requires an identifying User-Agent. Keep a project URL or contact method.
DISCOGS_USER_AGENT=Finder/0.2 +https://github.com/nictowey/Finder
