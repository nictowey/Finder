# eBay Developer application credentials, NOT your eBay login.
# EBAY_ENVIRONMENT selects its matching keyset. Both keysets can coexist safely.
EBAY_ENVIRONMENT=production
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=

# Relative SQLite paths resolve from the current working directory.
# Production scans must use the same PostgreSQL database as the deletion function.
# Sandbox scans can retain the local SQLite default.
FINDER_DATABASE_URL=sqlite:///finder.db
# Neon Function configuration for optional local deployment. The GitHub production
# deployment workflow reads the token from an Actions environment secret instead.
EBAY_DELETION_ENDPOINT_URL=
EBAY_DELETION_VERIFICATION_TOKEN=
FINDER_LOG_LEVEL=INFO
# Optional shipping destination; provide BOTH for accurate calculated shipping.
EBAY_DELIVERY_COUNTRY=US
EBAY_DELIVERY_POSTAL_CODE=

# Discogs personal access token from Settings > Developers.
DISCOGS_TOKEN=
# Discogs requires an identifying User-Agent. Keep a project URL or contact method.
DISCOGS_USER_AGENT=Finder/0.2 +https://github.com/nictowey/Finder

# Private watchlist deployment (owner address is kept in encrypted production secrets).
FINDER_OWNER_EMAIL=
FINDER_AUTH_URL=
FINDER_APP_ORIGIN=
FINDER_SEED_RELEASES=
